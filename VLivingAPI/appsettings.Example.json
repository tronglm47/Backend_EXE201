{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Initial Catalog=VLivingDb;Persist Security Info=True;User ID=sa;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;"
  },
  "JWT": {
    "Key": "YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "Issuer": "http://localhost:7027",
    "Audience": "http://localhost:7027",
    "ExpiryInMinutes": 60
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "YOUR_EMAIL@gmail.com",
    "Password": "YOUR_EMAIL_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL@gmail.com",
    "FromName": "VLiving Team",
    "EnableSsl": true,
    "BaseUrl": "http://localhost:7027",
    "DeleteTokenAfterUse": true
  },
  "GoogleCloudStorage": {
    "BucketName": "your-bucket-name",
    "ProjectId": "your-project-id",
    "UseEnvironmentCredentials": false,
    "CredentialPath": "vliving-service-account.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*"
}